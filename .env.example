# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Cloud PostgreSQL Connection string
DATABASE_URL="postgresql://your_user:your_password@your_cloud_db_host:5432/your_db_name"


# Local Docker / UAT Database Variables (Optional overrides)
DB_NAME="uoa_helpdesk_db"
DB_USER="postgres"
DB_PASSWORD="password123"

# SMTP Settings for Outbound Email & Status Notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_USE_SSL="false"

