# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration (for Docker)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/uoa_helpdesk_db"

# SMTP Settings for Outbound Email & Status Notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_USE_SSL="false"
